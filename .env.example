# ==============================================
# Docker Compose & Application Environment Variables
# Copy this file to .env before running docker-compose:
#   cp .env.example .env
# ==============================================

# Database Credentials (for local docker postgres)
POSTGRES_USER=snec_user
POSTGRES_PASSWORD=snec_password
POSTGRES_DB=snec_task_db

# Backend Configuration
PORT=5000
DATABASE_URL=postgresql://snec_user:snec_password@postgres:5432/snec_task_db?schema=public

# JWT Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production

# Initial Super Admin Seed (Optional)
ADMIN_EMAIL=admin-snec@gmail.com
ADMIN_PASS=Admin@123

# Email Service (Nodemailer SMTP for OTP & Invitations)
APP_EMAIL=your_email@gmail.com
APP_PASSWORD=your_app_specific_password

# Cloudinary Storage for Task Attachments
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=snec-task

# Frontend Next.js Public URL
NEXT_PUBLIC_API_URL=http://localhost:5000
